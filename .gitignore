# ==============================================================================
# Sensitive Files, API Keys & Credentials (NEVER COMMIT)
# ==============================================================================
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example

*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*credentials*.json
*secret*.json
id_rsa*

